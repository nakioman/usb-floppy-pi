[global]
   workgroup = WORKGROUP
   server string = USB Floppy Pi
   netbios name = FLOPPY
   security = user
   map to guest = bad user
   server min protocol = SMB2
   log file = /var/log/samba/log.%m
   max log size = 1000

[{{ share_name }}]
   path = /home/pi/floppies
   browseable = yes
   read only = no
   writable = yes
   guest ok = no
   valid users = {{ samba_user }}
   create mask = 0664
   directory mask = 0775
   force user = pi
   force group = pi

[Unit]
Description=USB Floppy Pi
# We only depend on kernel modules being loaded so the gadget can be created.
# Network is needed for the web UI but uvicorn binds 0.0.0.0:80 happily even
# before WiFi associates — connections will start succeeding as soon as DHCP
# completes, no need to BLOCK boot on it.
# Samba (smbd) is independent — its slowness shouldn't delay the gadget.
After=systemd-modules-load.service local-fs.target
DefaultDependencies=yes

[Service]
Type=simple
User=root
WorkingDirectory=/opt/usb-floppy-pi
Environment=USB_FLOPPY_CONFIG=/etc/usb-floppy-pi/config.json
Environment=USB_FLOPPY_ROOT=/home/pi/floppies
Environment=USB_FLOPPY_PORT=80
ExecStartPre=/sbin/modprobe libcomposite
ExecStartPre=/bin/sh -c 'mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config'
ExecStart=/opt/usb-floppy-pi/.venv/bin/python -m usb_floppy_pi
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
